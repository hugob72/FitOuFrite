<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC3F1666"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/prenomTextView"
        android:layout_width="114dp"
        android:layout_height="33dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="60dp"
        android:text="Prénom :"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.343"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="204dp"
        android:layout_height="158dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.026"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logoview" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/container"
        android:layout_width="211dp"
        android:layout_height="75dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toEndOf="@+id/prenomTextView"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/prenomInputText"
            style="@style/Widget.AppCompat.ActionBar"
            android:layout_width="208dp"
            android:layout_height="67dp"
            android:hint="Veuillez indiquer votre prénom"
            android:inputType="text|textPersonName"
            android:textSize="10sp"
            tools:visibility="invisible" />
    </com.google.android.material.textfield.TextInputLayout>


    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="258dp"
        android:layout_height="433dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="48dp"
        android:contentDescription="logo"
        android:src="@drawable/android_open"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/android_open" />

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="411dp"
        android:layout_height="120dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="25dp"
        android:background="#7c9fc7"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">

        <TextView
            android:id="@+id/bonjourText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/imcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonCalcul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="596dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#3C4D95"
        android:text="Calculer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>